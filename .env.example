# ─────────────────────────────────────────────────────────────
# Mini Legal Graph — exemplo de variáveis de ambiente
# Copie para .env e ajuste. NUNCA versione o .env real.
# ─────────────────────────────────────────────────────────────

# Banco de dados (Postgres + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mini_langgraph_legal
# Dentro do docker-compose o host é "postgres"; localmente use "localhost"
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/mini_langgraph_legal

# API
API_PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Autenticação
JWT_ACCESS_SECRET=troque-por-um-segredo-forte-access
JWT_REFRESH_SECRET=troque-por-um-segredo-forte-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Provider de IA (Hugging Face)
# Deixe AI_PROVIDER=fake para rodar sem chamadas externas (padrão em dev/testes).
# Use AI_PROVIDER=huggingface e preencha o token para IA real.
# IMPORTANTE: o seed indexa os documentos com o MESMO provider de embeddings do
# runtime. Ao trocar AI_PROVIDER (fake <-> huggingface), rode o seed de novo
# (npm run db:seed) para reindexar, senão a busca vetorial não encontra nada.
AI_PROVIDER=fake
HF_API_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_TIMEOUT_MS=30000

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_THRESHOLD=0.35

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
